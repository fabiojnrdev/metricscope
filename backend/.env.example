# App
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-minimum-32-characters-here
ALGORITHM=HS256

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/metricscope
DATABASE_TEST_URL=sqlite:///./test.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Sentry (optional)
SENTRY_DSN=

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
